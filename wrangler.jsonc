{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aliza-traders",
  "compatibility_date": "2026-08-25",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aliza-traders-production",
      "database_id": "local-placeholder-will-be-replaced-on-deploy"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "aliza-traders-images"
    }
  ]
}